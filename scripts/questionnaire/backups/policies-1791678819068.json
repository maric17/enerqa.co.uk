  {
    "id": 1,
    "title": "Privacy Notice",
    "slug": "privacy",
    "content": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "This Privacy Notice explains what personal data Enerqa collects through this website, how we use it, and who helps us process it.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          },
          {
            "tag": "h2",
            "type": "heading",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "What we collect",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          },
          {
            "tag": "ul",
            "type": "list",
            "start": 1,
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "listitem",
                "value": 1,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Contact form: your first and last name, email address, the type of enquiry and your message. If you choose, also your company, the tool, domain or industry the enquiry concerns, the project location and its current stage.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 2,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Newsletter sign-up: your email address and your consent to receive the newsletter.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 3,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Technical data: our hosting provider processes technical data, such as your IP address, to deliver the website to your browser.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              }
            ],
            "listType": "bullet",
            "direction": "ltr"
          },
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "We do not use analytics, advertising or tracking tools.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          },
          {
            "tag": "h2",
            "type": "heading",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "How we use it",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          },
          {
            "tag": "ul",
            "type": "list",
            "start": 1,
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "listitem",
                "value": 1,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "We use contact form details to respond to your enquiry.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 2,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "We use your email address for the newsletter only if you ticked the consent box. You can withdraw your consent at any time on the ",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  },
                  {
                    "type": "link",
                    "fields": {
                      "url": "/newsletter/unsubscribe",
                      "newTab": false,
                      "linkType": "custom"
                    },
                    "format": "",
                    "indent": 0,
                    "version": 3,
                    "children": [
                      {
                        "mode": "normal",
                        "text": "unsubscribe page",
                        "type": "text",
                        "style": "",
                        "detail": 0,
                        "format": 0,
                        "version": 1
                      }
                    ],
                    "direction": "ltr"
                  },
                  {
                    "mode": "normal",
                    "text": ".",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 3,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "We do not sell your personal data.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              }
            ],
            "listType": "bullet",
            "direction": "ltr"
          },
          {
            "tag": "h2",
            "type": "heading",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Who processes it",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          },
          {
            "tag": "ul",
            "type": "list",
            "start": 1,
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "listitem",
                "value": 1,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Vercel hosts the website.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 2,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Supabase hosts the database where form submissions are stored.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 3,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Only authorised Enerqa staff can read form submissions.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              }
            ],
            "listType": "bullet",
            "direction": "ltr"
          },
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Some tools and data views are provided by other websites, such as Gapminder. They load only if you choose, and those websites may then collect data under their own privacy policies. You can manage this on the ",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              },
              {
                "type": "link",
                "fields": {
                  "url": "/cookie-choices",
                  "newTab": false,
                  "linkType": "custom"
                },
                "format": "",
                "indent": 0,
                "version": 3,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Cookie Choices",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "mode": "normal",
                "text": " page.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          },
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "The website’s AI search is switched off, so no data is sent to AI services. We will update this notice before switching it on.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          },
          {
            "tag": "h2",
            "type": "heading",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Your rights",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          },
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "You can ask for a copy of the personal data we hold about you, or ask us to correct or delete it, by emailing ",
