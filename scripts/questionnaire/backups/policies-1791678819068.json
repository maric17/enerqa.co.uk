[
  {
    "id": 4,
    "title": "Accessibility Statement",
    "slug": "accessibility",
    "content": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "We want everyone to be able to use this website. We aim to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at level AA. This statement describes where we are today.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          },
          {
            "tag": "h2",
            "type": "heading",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "What we have checked",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          },
          {
            "tag": "ul",
            "type": "list",
            "start": 1,
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "listitem",
                "value": 1,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Links and buttons show a clearly visible focus outline when you use a keyboard.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 2,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "The search dialog and the mobile menu work with a keyboard: focus stays inside while they are open, Escape closes them, and focus returns to where you were.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 3,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Animations stop when your device is set to reduce motion, and the moving cards on the homepage have a pause button.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 4,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "We replaced low-contrast grey text that was hard to read.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 5,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "News and data panels keep their space while loading, so the page does not jump.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              }
            ],
            "listType": "bullet",
            "direction": "ltr"
          },
          {
            "tag": "h2",
            "type": "heading",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Known issues",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          },
          {
            "tag": "ul",
            "type": "list",
            "start": 1,
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "listitem",
                "value": 1,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Some form fields show their focus outline in a light colour that can be hard to see.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 2,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "The chart on the Data Portal page shows values by colour and on hover only, and has no table version yet.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 3,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Some pages skip a heading level.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 4,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "We have not yet tested every page at all screen sizes, at 125% zoom, on slow connections or with screen readers.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              }
            ],
            "listType": "bullet",
            "direction": "ltr"
          },
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "We will update this statement as we fix these issues and complete more testing.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          }
        ],
        "direction": "ltr"
      }
    },
    "updated_at": "2026-10-11T00:22:25.049Z",
    "created_at": "2026-09-26T04:16:54.286Z",
    "approved": true,
    "approved_by": "Enerqa",
    "approved_on": "2026-09-27T12:00:00.000Z",
    "policy_version": "1"
  },
  {
    "id": 3,
    "title": "Cookie Choices",
    "slug": "cookie-choices",
    "content": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "This website stores only what it needs to work, plus one optional choice: whether content from other websites loads automatically.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          },
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "We do not use tracking, analytics, marketing or advertising cookies.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          },
          {
            "tag": "h2",
            "type": "heading",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Always on",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          },
          {
            "tag": "ul",
            "type": "list",
            "start": 1,
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "listitem",
                "value": 1,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "A cookie that keeps Enerqa staff signed in to the content editor. It is set only for staff.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "listitem",
                "value": 2,
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Browser storage that remembers your choice on this page, and your language setting if you use the language switch.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr"
              }
            ],
            "listType": "bullet",
            "direction": "ltr"
          },
          {
            "tag": "h2",
            "type": "heading",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Content from other websites",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr"
          },
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "mode": "normal",
                "text": "Some tools and data views are hosted by other websites, such as Gapminder, which may set their own cookies. They load only if you click “Load content”, or if you allow embedded content below. You can change this at any time on this page.",
                "type": "text",
                "style": "",
                "detail": 0,
                "format": 0,
                "version": 1
              }
            ],
            "direction": "ltr",
            "textFormat": 0
          }
        ],
        "direction": "ltr"
      }
    },
    "updated_at": "2026-10-11T00:21:47.634Z",
    "created_at": "2026-09-26T04:16:52.970Z",
    "approved": true,
