[Unit]
Description=Enerqa production application
Requires=postgresql.service mnt-volume_fra1_1795093297184.mount
After=postgresql.service mnt-volume_fra1_1795093297184.mount network-online.target

[Service]
Type=simple
User=enerqa
Group=enerqa
WorkingDirectory=/opt/enerqa/current
EnvironmentFile=/etc/enerqa/production.env
Environment=PATH=/opt/enerqa/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStartPre=/usr/bin/mountpoint -q /mnt/volume_fra1_1795093297184
ExecStart=/opt/enerqa/node/bin/node /opt/enerqa/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
